# ===== search2ai 配置模板 =====
# 复制为 .env(本地/Zeabur/Vercel)或在 Worker 后台作为环境变量配置

# --- 大模型上游(OpenAI 兼容任意地址) ---
# 与 OpenAI SDK 的 baseURL 语义一致: 填 provider 文档里的完整前缀(host + 版本段), 不自动补版本号
# 默认 https://api.openai.com/v1
# 其它示例:
#   火山方舟: https://ark.cn-beijing.volces.com/api/v3
#   Gemini OpenAI 兼容端点: https://generativelanguage.googleapis.com/v1beta/openai
APIBASE=https://api.openai.com/v1
# 上游服务类型: openai(默认) | azure
OPENAI_TYPE=openai
# 请求者鉴权(多个用逗号分隔; 为空则接受任意 key 并透传)
# 配置后, 请求 key 必须在列表中, 上游改用下面的 OPENAI_API_KEY / AZURE_API_KEY
AUTH_KEYS=
OPENAI_API_KEY=

# --- Azure OpenAI(仅 OPENAI_TYPE=azure 时生效) ---
RESOURCE_NAME=
DEPLOY_NAME=gpt-35-turbo
API_VERSION=2024-02-15-preview
AZURE_API_KEY=

# --- 搜索服务(代理替你调搜索, 必须配置) ---
# 推荐: search1api(本项目配套搜索服务, 免费注册送 100 积分 https://www.search1api.com)
SEARCH_SERVICE=search1api
SEARCH1API_KEY=
# 备选搜索源(选一个填对应 key 即可): google / bing / serpapi / serper / searxng
# GOOGLE_CX=
# GOOGLE_KEY=
# SERPER_KEY=
# BING_KEY=
# SEARXNG_BASE_URL=

# --- 搜索参数(可选) ---
# MAX_RESULTS=5
# CRAWL_RESULTS=0
