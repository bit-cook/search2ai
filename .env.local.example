# ===== 本地测试配置(复制为 .env.local 后填写) =====
# 该文件仅用于本地测试, 已被 .gitignore 忽略, 不会提交到仓库

# --- 大模型 API(测试目标) ---
# 与 OpenAI SDK 的 baseURL 语义一致: 填 provider 文档里的完整前缀(host + 版本段)
APIBASE=https://api.openai.com/v1
# 你的大模型 API Key(OpenAI 等)。留空则从请求头读取
TEST_OPENAI_KEY=
# 测试用模型名。OpenAI 填 gpt-4o-mini 等; 火山方舟(Ark)填推理接入点 ID(如 ep-2025xxxx-xxxxx)
TEST_MODEL=

# --- 搜索服务(代理替你调搜索, 必须配置) ---
# 推荐: search1api(本项目配套搜索服务, 免费注册送 100 积分 https://www.search1api.com)
SEARCH_SERVICE=search1api
SEARCH1API_KEY=

# 备选搜索源(选一个填对应 key 即可)
# GOOGLE_CX=
# GOOGLE_KEY=
# SERPER_KEY=
# BING_KEY=

# --- 搜索参数(可选) ---
# MAX_RESULTS=5
# CRAWL_RESULTS=0
